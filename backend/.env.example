# Chỉ đặt trên server. Mỗi chế độ chỉ cần key của dịch vụ tương ứng.
DECART_API_KEY=
# Ảnh tĩnh: OpenAI chính; FASHN dùng riêng nếu không có OpenAI, hoặc làm dự phòng.
OPENAI_API_KEY=
FASHN_API_KEY=
# Mật khẩu demo riêng, ít nhất 12 ký tự; nhập trong app, không nhúng vào APK.
DEMO_PASSWORD=
HOST=127.0.0.1
PORT=8787
OPENAI_IMAGE_MODEL=gpt-image-1.5
DAILY_IMAGE_LIMIT=6
DAILY_LIVE_TOKEN_LIMIT=10
LIVE_MAX_SECONDS=120
USAGE_DB=./usage.sqlite
